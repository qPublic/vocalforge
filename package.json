{
  "name": "vocalforge",
  "version": "0.1.0-beta.24",
  "description": "Mic enhancement mixer: gate, EQ, compressor, limiter, routed to a virtual cable",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "test": "node --test --test-force-exit --test-timeout=120000 tests/*.test.js",
    "build:engine": "node scripts/build-engine.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "author": "benfe",
  "build": {
    "appId": "com.vocalforge.app",
    "productName": "VocalForge",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "license": "LICENSE",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "VocalForge",
      "uninstallDisplayName": "VocalForge"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "qPublic",
        "repo": "vocalforge",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "engine/build/engine.exe",
        "to": "engine/engine.exe"
      },
      {
        "from": "engine/third_party/rnnoise/COPYING",
        "to": "engine/RNNOISE-LICENSE.txt"
      }
    ]
  }
}
