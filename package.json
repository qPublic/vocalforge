{
  "name": "vocalforge",
  "version": "0.1.0-beta.3",
  "description": "Mic enhancement mixer: gate, EQ, compressor, limiter, routed to a virtual cable",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "author": "benfe",
  "build": {
    "appId": "com.vocalforge.app",
    "productName": "VocalForge",
    "files": [
      "main.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "VocalForge",
      "uninstallDisplayName": "VocalForge"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "qPublic",
        "repo": "vocalforge",
        "releaseType": "release"
      }
    ]
  }
}
